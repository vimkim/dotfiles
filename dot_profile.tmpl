# Optional environment files created by uv and Cargo installers.
if [ -r "$HOME/.local/bin/env" ]; then
    . "$HOME/.local/bin/env"
fi
if [ -r "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
fi

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

{{ template "deeptutor-env.sh" . }}

# >>> Codex installer >>>
export PATH="{{ .chezmoi.homeDir }}/.local/bin:$PATH"
# <<< Codex installer <<<

# mise tools through shims for every login shell (sh, bash, nu-less sessions).
# Shims work without `mise activate`, so non-interactive shells see them too.
if [ -d "$HOME/.local/share/mise/shims" ]; then
    case ":$PATH:" in
        *":$HOME/.local/share/mise/shims:"*) ;;
        *) export PATH="$HOME/.local/share/mise/shims:$PATH" ;;
    esac
fi
