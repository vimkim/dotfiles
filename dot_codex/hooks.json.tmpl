{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "^(startup|clear|compact)$",
        "hooks": [
          {
            "command": "work-tracker hook session-start",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
