{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '{{ .chezmoi.homeDir }}/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 '{{ .chezmoi.homeDir }}/.codex/hooks/daily-usage.py' hook --daily-cap 33 --warn-at 25",
            "timeout": 25,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 '{{ .chezmoi.homeDir }}/.codex/hooks/daily-usage.py' hook --daily-cap 33 --warn-at 25",
            "timeout": 25,
            "type": "command"
          }
        ]
      }
    ]
  }
}
