#!/usr/bin/env python3

"""Decorate Herdr tabs and publish a per-workspace agent inventory."""

import argparse
import fcntl
import hashlib
import json
import math
import os
import select
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import threading
import time
import unicodedata
from collections import defaultdict
from pathlib import Path

SOURCE = "user:tab-status"
MARKERS = {"working": "▶", "blocked": "!", "done": "✓", "idle": "○", "unknown": "?"}
STATUS_ROWS = 13
ROW_WIDTH = 44
TOKEN_NAMES = ["tab_inventory", *[f"tab_states_{i}" for i in range(1, STATUS_ROWS + 1)]]
TTL_MS = 60_000
HEARTBEAT_SECONDS = 20
SUBSCRIPTIONS = (
    "workspace.created",
    "workspace.closed",
    "tab.created",
    "tab.closed",
    "tab.moved",
    "tab.renamed",
    "tab.focused",
    "pane.created",
    "pane.closed",
    "pane.moved",
    "pane.exited",
    "pane.focused",
    "pane.agent_detected",
    "pane.updated",
)
PANE_STATE_FIELDS = ("workspace_id", "tab_id", "agent", "agent_status")


class HerdrError(RuntimeError):
    pass


def open_control_socket(path):
    # Call only while holding the worker lock, so an existing socket is stale.
    try:
        mode = path.lstat().st_mode
    except FileNotFoundError:
        pass
    else:
        if not stat.S_ISSOCK(mode):
            raise HerdrError(f"control path is not a socket: {path}")
        path.unlink()
    server = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    try:
        server.bind(str(path))
        path.chmod(0o600)
        return server
    except BaseException:
        server.close()
        raise


def request_stop(path):
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
        client.settimeout(3)
        client.sendto(b"stop", str(path))


class WorkerControl:
    """Wake the main thread for Herdr events, stop requests, or signals."""

    def __init__(self, path, server=None):
        self.path = path
        self.server = server if server is not None else open_control_socket(path)
        self.server.setblocking(False)
        self.reader, self.writer = socket.socketpair()
        self.reader.setblocking(False)
        self.writer.setblocking(False)
        self.stopped = threading.Event()

    def __enter__(self):
        return self

    def __exit__(self, _exc_type, _exc_value, _traceback):
        self.reader.close()
        self.writer.close()
        self.server.close()
        self.path.unlink(missing_ok=True)

    def set(self):
        try:
            self.writer.send(b"\0")
        except BlockingIOError:
            pass  # A queued notification already makes the reader ready.

    def clear(self):
        try:
            while self.reader.recv(4096):
                pass
        except BlockingIOError:
            pass

    def stop(self):
        self.stopped.set()
        self.set()

    def stopping(self):
        # Drain commands when processing events too, so a busy stream cannot
        # defer stopping until the next wait. This is not a timed file check.
        try:
            if self.server.recv(16) == b"stop":
                self.stopped.set()
        except BlockingIOError:
            pass
        return self.stopped.is_set()

    def wait(self, timeout=None):
        ready, _write, _error = select.select(
            [self.reader, self.server], [], [], timeout
        )
        if self.server in ready:
            self.stopping()


class EventFeed:
    """Drain notifications during API calls; events only invalidate snapshots."""

    def __init__(self, updater, wake, pane_ids=()):
        self.updater = updater
        self.wake = wake
        self.revision = 0
        self.error = None
        self.panes = {}
        self.pane_ids = frozenset(pane_ids)
        self.lock = threading.Lock()
        self.client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.stream = None
        self.thread = None

    def __enter__(self):
        try:
            self.client.settimeout(3)
            self.client.connect(self.updater.socket_path)
            self.stream = self.client.makefile("rb")
            subscriptions = [{"type": kind} for kind in SUBSCRIPTIONS]
            subscriptions.extend(
                {"type": "pane.agent_status_changed", "pane_id": pane_id}
                for pane_id in sorted(self.pane_ids)
            )
            payload = {
                "id": "tab-status-events",
                "method": "events.subscribe",
                "params": {"subscriptions": subscriptions},
            }
            self.client.sendall(
                (json.dumps(payload, separators=(",", ":")) + "\n").encode()
            )
            response = self.read()
            if (
                response.get("id") != "tab-status-events"
                or response.get("result", {}).get("type") != "subscription_started"
            ):
                raise HerdrError("event subscription was not acknowledged")
            self.client.settimeout(None)
            self.thread = threading.Thread(target=self.receive, daemon=True)
            self.thread.start()
            return self
        except BaseException:
            self.__exit__(None, None, None)
            raise

    def __exit__(self, _exc_type, _exc_value, _traceback):
        try:
            self.client.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        if self.thread:
            self.thread.join(timeout=4)
        if self.stream:
            self.stream.close()
        self.client.close()

    def read(self):
        line = self.stream.readline(16 * 1024 * 1024 + 1)
        if not line or not line.endswith(b"\n"):
            raise HerdrError("event subscription disconnected")
        message = json.loads(line)
        if not isinstance(message, dict):
            raise HerdrError("invalid event subscription response")
        if "error" in message:
            error = message["error"]
            raise HerdrError(
                f"event subscription: {error.get('code', 'error')}: "
                f"{error.get('message', 'Herdr API error')}"
            )
        return message

    def observe(self, snapshot):
        with self.lock:
            self.panes = {
                pane["pane_id"]: tuple(pane.get(key) for key in PANE_STATE_FIELDS)
                for pane in snapshot.get("panes", [])
            }

    def receive(self):
        try:
            while True:
                message = self.read()
                kind, data = message.get("event"), message.get("data", {})
                if not isinstance(kind, str) or not isinstance(data, dict):
                    raise HerdrError("invalid event envelope")
                if kind == "tab_renamed":
                    record = self.updater.tabs.get(data.get("tab_id"))
                    if record and data.get("label") in record["labels"]:
                        continue
                with self.lock:
                    if kind == "pane_updated":
                        pane = data["pane"]
                        if not isinstance(pane, dict):
                            raise HerdrError("invalid pane update event")
                        state = tuple(pane.get(key) for key in PANE_STATE_FIELDS)
                        if self.panes.get(pane["pane_id"]) == state:
                            continue
                    self.revision += 1
                self.wake.set()
        except (OSError, ValueError, KeyError, HerdrError) as error:
            self.error = error
            self.wake.set()


def request(socket_path, method, params):
    payload = {"id": "tab-status", "method": method, "params": params}
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(3)
        client.connect(socket_path)
        with client.makefile("rwb") as stream:
            stream.write(json.dumps(payload, separators=(",", ":")).encode() + b"\n")
            stream.flush()
            line = stream.readline(16 * 1024 * 1024 + 1)
    if not line or not line.endswith(b"\n"):
        raise HerdrError(f"incomplete response to {method}")
    response = json.loads(line)
    if response.get("id") != payload["id"]:
        raise HerdrError(f"unexpected response id for {method}")
    if "error" in response:
        raise HerdrError(response["error"].get("message", "Herdr API error"))
    return response["result"]


def display_width(value):
    return sum(
        0
        if unicodedata.combining(char)
        else 2
        if unicodedata.east_asian_width(char) in "WF"
        else 1
        for char in value
    )


def pack_rows(entries, separator):
    rows = []
    for entry in entries:
        if rows and display_width(rows[-1] + separator + entry) <= ROW_WIDTH:
            rows[-1] += separator + entry
        else:
            rows.append(entry)
    return rows


def original_label(label, record):
    if record:
        if label == record["base"]:
            return label, False
        if label in record["labels"]:
            return record["base"], True
        for suffix in record["suffixes"]:
            if label.endswith(suffix):
                base = label[: -len(suffix)]
                for prefix in record.get("prefixes", []):
                    if base.startswith(prefix):
                        base = base[len(prefix) :]
                        break
                return base, True
    return label, False


def format_duration(seconds):
    minutes = max(0, int(seconds // 60))
    if minutes < 1:
        return "<1m"
    if minutes < 60:
        return f"{minutes}m"
    hours, minutes = divmod(minutes, 60)
    if hours < 24:
        return f"{hours}h{minutes:02d}m"
    days, hours = divmod(hours, 24)
    return f"{days}d{hours:02d}h"


def build_plan(snapshot, saved_tabs, now=None):
    # Missing agent data must never turn every live tab into a "shell" tab.
    if any(
        not isinstance(snapshot.get(key), list)
        for key in ("workspaces", "tabs", "agents")
    ):
        raise HerdrError("snapshot is missing workspace, tab, or agent lists")
    now = time.time() if now is None else now
    agents_by_tab = defaultdict(list)
    for agent in snapshot["agents"]:
        agents_by_tab[agent["tab_id"]].append(agent)
    tabs_by_workspace = defaultdict(list)
    tabs = []
    for tab in snapshot["tabs"]:
        # Snapshot array order follows the native tab bar. API `number` is the
        # stable creation number and can have gaps or change order after moves.
        position = len(tabs_by_workspace[tab["workspace_id"]]) + 1
        agents = agents_by_tab[tab["tab_id"]]
        state = (
            (tab["agent_status"] if tab["agent_status"] in MARKERS else "unknown")
            if agents
            else "shell"
        )
        marker = MARKERS.get(state, "—")
        kinds = sorted({agent.get("agent") or "agent" for agent in agents})
        name = "+".join(kind.title() for kind in kinds) if agents else "shell"
        if len(agents) > 1:
            name += f" ×{len(agents)}"
        # Keep sidebar names bounded; original tab names are never shortened.
        short_name = name if len(name) <= 18 else name[:17] + "…"
        record = saved_tabs.get(tab["tab_id"])
        state_since = (
            record["state_since"] if record and record.get("state") == state else now
        )
        # A backwards wall-clock adjustment must never display negative ages.
        state_since = min(state_since, now)
        duration = format_duration(now - state_since) if agents else ""
        age = f" {duration}" if duration else ""
        base, owned = original_label(tab["label"], record)
        prefix = f"{position} "
        # Bare numeric names are Herdr's generated defaults. Keep the original
        # for restoration, but display only the current shortcut position.
        title = (
            str(position)
            if base.isascii() and base.isdecimal()
            else prefix + base
        )
        suffix = f" [{marker} {name}{age}]"
        item = {
            "tab_id": tab["tab_id"],
            "base": base,
            "label": title + suffix,
            "prefix": prefix,
            "suffix": suffix,
            "current": tab["label"],
            "owned": owned,
            "number": tab["number"],
            "position": position,
            "marker": marker,
            "state": state,
            "state_since": state_since,
            "duration": duration,
            "agent_count": len(agents),
            "summary": f"{position} {marker} {short_name}{age}",
            "compact_summary": f"{position}{marker}{duration}",
        }
        tabs.append(item)
        tabs_by_workspace[tab["workspace_id"]].append(item)
    workspaces = {}
    for workspace in snapshot["workspaces"]:
        ordered = tabs_by_workspace[workspace["workspace_id"]]
        rows = pack_rows([tab["summary"] for tab in ordered], " · ")
        if len(rows) > STATUS_ROWS:
            rows = pack_rows([tab["compact_summary"] for tab in ordered], " ")
        if len(rows) > STATUS_ROWS:
            rows = rows[: STATUS_ROWS - 1] + ["More tab states in the tab bar"]
        tokens = dict.fromkeys(TOKEN_NAMES)
        agent_count = sum(tab["agent_count"] for tab in ordered)
        counts = [
            (len(ordered), "tab"),
            (workspace["pane_count"], "pane"),
            (agent_count, "agent"),
        ]
        tokens["tab_inventory"] = " · ".join(
            f"{count} {noun}{'' if count == 1 else 's'}" for count, noun in counts
        )
        for index, row in enumerate(rows, 1):
            tokens[f"tab_states_{index}"] = row
        workspaces[workspace["workspace_id"]] = tokens
    return {"tabs": tabs, "workspaces": workspaces}


class Updater:
    def __init__(self, socket_path, directory):
        self.socket_path = socket_path
        self.directory = directory
        self.state_path = directory / "state.json"
        self.tabs = {}
        self.published = {}
        if self.state_path.exists():
            state = json.loads(self.state_path.read_text())
            if state.get("version") != 1 or not isinstance(state.get("tabs"), dict):
                raise HerdrError(f"invalid label journal: {self.state_path}")
            self.tabs = state["tabs"]
            for record in self.tabs.values():
                if (
                    not isinstance(record, dict)
                    or not isinstance(record.get("base"), str)
                    or not isinstance(record.get("labels"), list)
                    or not all(isinstance(value, str) for value in record["labels"])
                    or not isinstance(record.get("suffixes"), list)
                    or not all(
                        isinstance(value, str) and value for value in record["suffixes"]
                    )
                    or not isinstance(record.get("prefixes", []), list)
                    or not all(
                        isinstance(value, str) and value
                        for value in record.get("prefixes", [])
                    )
                ):
                    raise HerdrError(f"invalid label journal: {self.state_path}")
                # Older journals contain only label ownership. Timing starts on
                # the first observation after upgrade; keep their original names.
                if "state" in record or "state_since" in record:
                    since = record.get("state_since")
                    if (
                        record.get("state") not in (*MARKERS, "shell")
                        or isinstance(since, bool)
                        or not isinstance(since, (int, float))
                        or not math.isfinite(since)
                        or since < 0
                    ):
                        raise HerdrError(f"invalid label journal: {self.state_path}")

    def snapshot(self):
        return request(self.socket_path, "session.snapshot", {})["snapshot"]

    def save(self):
        temporary = None
        try:
            with tempfile.NamedTemporaryFile(
                mode="w", dir=self.directory, delete=False
            ) as stream:
                temporary = Path(stream.name)
                json.dump({"version": 1, "tabs": self.tabs}, stream, ensure_ascii=False)
                stream.flush()
                os.fsync(stream.fileno())
            temporary.replace(self.state_path)
        finally:
            if temporary is not None:
                temporary.unlink(missing_ok=True)

    def preview(self):
        return build_plan(self.snapshot(), self.tabs)

    def update(self, snapshot=None):
        # Timer updates reuse the last authoritative snapshot. Reflect successful
        # writes in that cache so timers never re-adopt our own decorations.
        snapshot = self.snapshot() if snapshot is None else snapshot
        plan = build_plan(snapshot, self.tabs)
        current_tabs = {tab["tab_id"]: tab for tab in snapshot["tabs"]}
        journal = {}
        for tab in plan["tabs"]:
            labels = [tab["label"]]
            suffixes = [tab["suffix"]]
            prefixes = [tab["prefix"]]
            if tab["owned"]:
                labels.append(tab["current"])
                previous = self.tabs[tab["tab_id"]]
                suffixes.extend(
                    suffix
                    for suffix in previous["suffixes"]
                    if tab["current"].endswith(suffix)
                )
                prefixes.extend(
                    prefix
                    for prefix in previous.get("prefixes", [])
                    if tab["current"].startswith(prefix)
                )
            journal[tab["tab_id"]] = {
                "base": tab["base"],
                "labels": list(dict.fromkeys(labels)),
                "suffixes": list(dict.fromkeys(suffixes)),
                "prefixes": list(dict.fromkeys(prefixes)),
                "state": tab["state"],
                "state_since": tab["state_since"],
            }
        if journal != self.tabs:
            # Persist both possible labels before rename: a lost API reply must
            # not lose the original name or double-decorate after a restart.
            self.tabs = journal
            self.save()
        for tab in plan["tabs"]:
            if tab["label"] != tab["current"]:
                request(
                    self.socket_path,
                    "tab.rename",
                    {"tab_id": tab["tab_id"], "label": tab["label"]},
                )
                current_tabs[tab["tab_id"]]["label"] = tab["label"]
        now = time.monotonic()
        for workspace_id, tokens in plan["workspaces"].items():
            previous, published_at = self.published.get(workspace_id, (None, 0))
            if tokens != previous or now - published_at >= HEARTBEAT_SECONDS:
                request(
                    self.socket_path,
                    "workspace.report_metadata",
                    {
                        "workspace_id": workspace_id,
                        "source": SOURCE,
                        "tokens": tokens,
                        "ttl_ms": TTL_MS,
                    },
                )
                self.published[workspace_id] = (tokens, now)
        self.published = {
            key: value
            for key, value in self.published.items()
            if key in plan["workspaces"]
        }
        return plan

    def restore(self):
        snapshot = self.snapshot()
        for tab in snapshot["tabs"]:
            base, owned = original_label(tab["label"], self.tabs.get(tab["tab_id"]))
            if owned:
                request(
                    self.socket_path,
                    "tab.rename",
                    {"tab_id": tab["tab_id"], "label": base},
                )
        for workspace in snapshot["workspaces"]:
            request(
                self.socket_path,
                "workspace.report_metadata",
                {
                    "workspace_id": workspace["workspace_id"],
                    "source": SOURCE,
                    "tokens": dict.fromkeys(TOKEN_NAMES),
                },
            )
        self.tabs = {}
        self.save()


def open_lock(directory):
    descriptor = os.open(directory / "lock", os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(descriptor)
        return None
    return descriptor


def timer_delay(updater, plan):
    """Schedule displayed ages and metadata leases without reading Herdr."""
    monotonic_now, wall_now = time.monotonic(), time.time()
    delays = [
        published_at + HEARTBEAT_SECONDS - monotonic_now
        for _tokens, published_at in updater.published.values()
    ]
    delays.extend(
        60 - max(0, wall_now - tab["state_since"]) % 60
        for tab in plan["tabs"]
        if tab["agent_count"]
    )
    return max(0.05, min(delays)) if delays else None


def run_events(updater, control, retry_delay):
    last_error = None
    pane_ids = frozenset()
    while not control.stopping():
        try:
            # Subscribe before the first read. The reader keeps draining while
            # snapshots and writes run; a changed revision triggers another read.
            with EventFeed(updater, control, pane_ids) as feed:
                snapshot, revision, deadline = None, -1, 0
                while not control.stopping():
                    if feed.error:
                        raise feed.error
                    refresh = feed.revision != revision
                    if refresh:
                        revision = feed.revision
                        snapshot = updater.snapshot()
                        feed.observe(snapshot)
                        pane_ids = frozenset(
                            pane["pane_id"] for pane in snapshot.get("panes", [])
                        )
                        if pane_ids != feed.pane_ids:
                            # State subscriptions require explicit pane IDs.
                            # Resubscribe, then read again to cover the gap.
                            break
                        if feed.revision != revision:
                            continue
                    if refresh or time.monotonic() >= deadline:
                        plan = updater.update(snapshot)
                        delay = timer_delay(updater, plan)
                        deadline = (
                            time.monotonic() + delay if delay is not None else math.inf
                        )
                        last_error = None
                    control.clear()
                    if control.stopping() or feed.error or feed.revision != revision:
                        continue
                    timeout = (
                        None if math.isinf(deadline)
                        else max(0, deadline - time.monotonic())
                    )
                    control.wait(timeout)
        except (OSError, ValueError, KeyError, HerdrError) as error:
            # A pane may close between discovery and subscription acceptance.
            # Rediscover IDs under lifecycle subscriptions on the next attempt.
            pane_ids = frozenset()
            message = str(error)
            if message != last_error:
                print(f"herdr-tab-status: {message}", file=sys.stderr, flush=True)
                last_error = message
            control.clear()
            if not control.stopping():
                control.wait(retry_delay)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("start", "run", "once", "preview", "stop"))
    parser.add_argument(
        "--retry-delay",
        "--interval",
        dest="retry_delay",
        type=float,
        default=2,
        help="event connection retry delay in seconds (default: 2)",
    )
    parser.add_argument("--lock-fd", type=int, help=argparse.SUPPRESS)
    parser.add_argument("--control-fd", type=int, help=argparse.SUPPRESS)
    args = parser.parse_args()
    if not math.isfinite(args.retry_delay) or args.retry_delay < 0.05:
        parser.error("retry delay must be a finite number of at least 0.05 seconds")
    if os.environ.get("HERDR_ENV") != "1" or not os.environ.get("HERDR_SOCKET_PATH"):
        parser.error("run inside a Herdr pane with HERDR_SOCKET_PATH set")
    socket_path = str(Path(os.environ["HERDR_SOCKET_PATH"]).resolve())
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    key = hashlib.sha256(socket_path.encode()).hexdigest()[:20]
    directory = cache / "herdr-tab-status" / key
    if args.command == "preview":
        print(
            json.dumps(
                Updater(socket_path, directory).preview(), ensure_ascii=False, indent=2
            )
        )
        return
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    control_path = directory / "control.sock"
    descriptor = args.lock_fd if args.lock_fd is not None else open_lock(directory)
    if descriptor is None:
        if args.command == "stop":
            request_stop(control_path)
        elif args.command != "start":
            raise HerdrError("an updater is already running for this session")
        return
    try:
        if args.command == "start":
            if not Path(socket_path).is_socket():
                raise HerdrError("Herdr session socket is unavailable")
            # Bind before spawning so an immediate stop request is queued even
            # before the child starts. Only the child removes this endpoint.
            control_server = open_control_socket(control_path)
            try:
                log_fd = os.open(
                    directory / "updater.log",
                    os.O_CREAT | os.O_WRONLY | os.O_APPEND, 0o600,
                )
                try:
                    subprocess.Popen(
                        [
                            sys.executable,
                            str(Path(__file__).resolve()),
                            "run",
                            "--retry-delay",
                            str(args.retry_delay),
                            "--lock-fd",
                            str(descriptor),
                            "--control-fd",
                            str(control_server.fileno()),
                        ],
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL,
                        stderr=log_fd,
                        pass_fds=(descriptor, control_server.fileno()),
                        start_new_session=True,
                    )
                finally:
                    os.close(log_fd)
            except BaseException:
                control_path.unlink(missing_ok=True)
                raise
            finally:
                control_server.close()
            return
        updater = Updater(socket_path, directory)
        if args.command == "once":
            updater.update()
            return
        if args.command == "stop":
            updater.restore()
            return
        control_server = (
            socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM, fileno=args.control_fd)
            if args.control_fd is not None else None
        )
        with WorkerControl(control_path, control_server) as control:
            for signum in (signal.SIGTERM, signal.SIGINT):
                signal.signal(signum, lambda _signum, _frame: control.stop())
            try:
                run_events(updater, control, args.retry_delay)
            finally:
                try:
                    updater.restore()
                except (OSError, ValueError, KeyError, HerdrError) as error:
                    print(
                        f"herdr-tab-status: restore pending: {error}",
                        file=sys.stderr,
                        flush=True,
                    )
    finally:
        os.close(descriptor)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, HerdrError) as error:
        print(f"herdr-tab-status: {error}", file=sys.stderr)
        raise SystemExit(1)
