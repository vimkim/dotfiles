#!/bin/sh

cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}"
log_file="$cache_dir/no-browser.log"

mkdir -p "$cache_dir" 2>/dev/null || true

if [ "$#" -gt 0 ]; then
    target="$*"
else
    target="(no URL argument)"
fi

timestamp="$(date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || date)"
printf '%s\t%s\n' "$timestamp" "$target" >> "$log_file" 2>/dev/null || true

# Copy the URL to the local clipboard with OSC 52, like `clip` over SSH.
# The controlling terminal reaches the user's terminal even when the caller
# (for example Herdr's Ctrl-click opener) has redirected stdio.
copied=
if [ "$#" -gt 0 ]; then
    encoded=$(printf '%s' "$target" | base64 2>/dev/null | tr -d '\n')
    if [ -n "$encoded" ] \
        && { printf '\033]52;c;%s\a' "$encoded" > /dev/tty; } 2>/dev/null; then
        copied=1
    fi
fi

# Confirm the copy with a Herdr toast. Without a reachable Herdr server the
# copy and log still happen; the toast is skipped within two seconds.
if [ -n "$copied" ] && command -v herdr >/dev/null 2>&1; then
    timeout 2 herdr notification show "📋 Copied link" --body "$target" \
        --position bottom-right --sound none >/dev/null 2>&1 || true
fi

{
    printf 'Blocked browser open'
    if [ "$#" -gt 0 ]; then
        printf ': %s' "$target"
    fi
    printf '\n'
    if [ -n "$copied" ]; then
        printf 'Copied URL to clipboard (OSC 52)\n'
    fi
    printf 'Logged at %s\n' "$log_file"
} >&2

# Return success so browser libraries do not fall through to xdg-open/firefox.
exit 0
