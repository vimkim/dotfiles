#!/usr/bin/env python3

import argparse
from dataclasses import dataclass
import json
import os
from pathlib import Path
import subprocess
import sys
import time

VERSION = "1.2.0"
MIN_REMAINING = 10


@dataclass(frozen=True)
class Candidate:
    name: str
    selector: str
    remaining: list[float | None]
    source: str
    observed_at: float | None
    unavailable: str | None
    automatic: bool
    tier: int | None = 0
    policy: str = "primary"
    permitted_until: str | None = None

    @property
    def low(self) -> bool:
        return any(value is not None and value < MIN_REMAINING for value in self.remaining)

    def priority(self) -> tuple:
        tier = self.tier if type(self.tier) is int else 0
        five_hour, seven_day = self.remaining
        if five_hour is None or seven_day is None:
            return (tier, 1, 0, 0, 0)
        return (tier, 0, -min(five_hour, seven_day), -five_hour, -seven_day)

    def describe(self, now: float) -> str:
        fields = [f"{title} {value:g}% left" if value is not None else f"{title} unknown"
                  for title, value in zip(("5h", "7d"), self.remaining)]
        if self.observed_at is not None:
            fields.append(f"{self.source}, {max(0, int(now - self.observed_at))}s old")
        if self.unavailable:
            fields.append(self.unavailable)
        if self.policy == "permit_required":
            fields.append(f"restricted (permit required: claude-account permit {self.selector})")
        elif not self.automatic:
            fields.append("manual only")
        elif self.policy == "fallback_permitted":
            suffix = f" until {self.permitted_until}" if self.permitted_until else ""
            fields.append(f"fallback (permitted{suffix})")
        if self.low:
            fields.append(f"warning: below {MIN_REMAINING}%")
        return f"{self.name}  " + " · ".join(fields)


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="ai-best",
        description="Choose a Claude account and start Claude in the current terminal.",
        epilog=(
            "Score each account by the lower of its 5-hour and 7-day remaining percentages. "
            f"Skip accounts with less than {MIN_REMAINING}% in either window. Try configured "
            "accounts with unknown usage after accounts with two known percentages. "
            "Prefer unrestricted numbered slots (ai0, ai3, etc.) first. Restricted slots "
            "(ai1, ai2) stay out unless granted a 7-day permit (`claude-account permit N`), "
            "and are used only as fallback when no primary slot qualifies. Never start "
            "ai-login; start that by name.\n\n"
            "Examples:\n"
            "  ai-best                    Start Claude here.\n"
            "  ai-best -- --resume        Pass --resume to Claude.\n"
            "  herdr-new-tab-ai-best      Start in a new Herdr tab.\n"
            "  herdr-new-workspace-ai-best  Start in a new Herdr workspace."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}",
                        help="print the ai-best version and exit")
    parser.add_argument("claude_args", nargs=argparse.REMAINDER, metavar="CLAUDE_ARG",
                        help="arguments for Claude (prefix options with --)")
    args = parser.parse_args().claude_args
    if args and args[0] == "--":
        args = args[1:]

    account = Path(__file__).resolve().with_name("claude-account")
    try:
        snapshot = subprocess.check_output([account, "usage-snapshot"], text=True)
    except (OSError, subprocess.CalledProcessError):
        sys.exit("ai-best: could not read account usage")
    try:
        candidates = [Candidate(**data) for data in json.loads(snapshot)]
    except (ValueError, TypeError):
        sys.exit("ai-best: invalid account usage data")

    now = time.time()
    for candidate in candidates:
        print(candidate.describe(now), file=sys.stderr)
    eligible = (item for item in candidates if item.automatic and not item.unavailable and not item.low)
    # The snapshot lists numbered slots in order, so ties keep the lowest slot.
    selected = min(eligible, key=Candidate.priority, default=None)
    if selected is None:
        sys.exit(f"ai-best: no configured account qualifies at the {MIN_REMAINING}% minimum")
    fallback_note = " (fallback)" if selected.policy == "fallback_permitted" or (type(selected.tier) is int and selected.tier > 0) else ""
    note = " with unknown allowance" if None in selected.remaining else ""
    print(f"Starting {selected.name}{fallback_note}{note}", file=sys.stderr, flush=True)
    try:
        os.execv(account, [str(account), "run", selected.selector, *args])
    except OSError:
        sys.exit("ai-best: could not run claude-account")


if __name__ == "__main__":
    main()
