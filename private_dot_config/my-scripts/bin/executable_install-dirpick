#!/usr/bin/env bash
# Bootstrap Dirpick through its sync recipe. Install only primary main.
set -eu

checkout="$HOME/gh/dirpick"
retry() {
    printf 'dirpick: %s\n' "$1" >&2
    printf 'Retry after correcting it: %s/.config/my-scripts/bin/install-dirpick\n' "$HOME" >&2
    exit 1
}

command -v git >/dev/null || retry 'install git first'
command -v just >/dev/null || retry 'install just first'
if command -v cargo >/dev/null 2>&1; then
    :
elif [ -x "$HOME/.cargo/bin/cargo" ]; then
    # Noninteractive chezmoi scripts may not inherit the Rust proxy PATH.
    export PATH="$HOME/.cargo/bin:$PATH"
else
    retry 'install Rust and Cargo first: https://rustup.rs'
fi

if [ ! -e "$checkout" ] && [ ! -L "$checkout" ]; then
    mkdir -p "$(dirname "$checkout")"
    git clone --quiet --branch main https://github.com/vimkim/dirpick.git "$checkout" ||
        retry 'clone failed; inspect any partial checkout before retrying'
fi
[ -d "$checkout/.git" ] && [ ! -L "$checkout" ] || retry 'occupied path or linked worktree; preserved'
root="$(git -C "$checkout" rev-parse --show-toplevel)" || retry 'cannot inspect checkout'
[ "$root" = "$(cd "$checkout" && pwd -P)" ] || retry 'path is not an independent checkout'
branch="$(git -C "$checkout" symbolic-ref --quiet --short HEAD)" || retry 'detached checkout; preserved'
[ "$branch" = main ] || retry 'checkout is not on main; preserved'
origin="$(git -C "$checkout" config --get remote.origin.url)" || retry 'missing origin; preserved'
case "$origin" in
https://github.com/vimkim/dirpick.git|git@github.com:vimkim/dirpick.git) ;;
*) retry 'unexpected origin; preserved' ;;
esac
status="$(git -C "$checkout" status --porcelain --untracked-files=all)" || retry 'cannot inspect status'
[ -z "$status" ] || retry 'dirty checkout; preserved'
[ -f "$checkout/Cargo.toml" ] && [ -f "$checkout/Cargo.lock" ] || retry 'missing Cargo.toml or Cargo.lock'
[ -f "$checkout/justfile" ] || retry 'missing local justfile; update the clean main checkout first'

# Use the checkout's installation recipe without discovering a parent justfile.
(cd "$checkout" && just --justfile ./justfile sync) ||
    retry 'installation failed'
