#!/usr/bin/env python3

import datetime
from dataclasses import dataclass, replace
import fcntl
import getpass
import hashlib
import http.client
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request

TOKEN_VAR = "CLAUDE_CODE_OAUTH_TOKEN"
SLOT_VAR = "CLAUDE_ACCOUNT_SLOT"
FINGERPRINT_VAR = "CLAUDE_ACCOUNT_FINGERPRINT"
OVERRIDING_VARS = ("ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_API_KEY")
TOKEN_DAYS = 365
WINDOWS = ("five_hour", "seven_day")
ROUND_MIN_REMAINING = 20
SHORTCUTS = {
    "ai": ("run", "login"),
    "ai-login": ("run", "login"),
    **{f"ai{slot}": ("run", str(slot)) for slot in range(10)},
    "aip": ("run", "login", "read prompt.md and execute"),
    "ai-status": ("status", "--all"),
    "ai-round": ("round",),
}
USAGE = """usage: claude-account run [login | SLOT] [CLAUDE_ARGS...]
       claude-account round [CLAUDE_ARGS...]
       claude-account add SLOT [--label TEXT] [--username TEXT] [--paste]
       claude-account label SLOT [--label TEXT] [--username TEXT]
       claude-account list
       claude-account status [login | SLOT | --all]
       claude-account remove SLOT"""


def fail(message: str, code: int = 1) -> None:
    print(f"claude-account: {message}", file=sys.stderr)
    raise SystemExit(code)


def accounts_dir() -> Path:
    if os.environ.get("CLAUDE_ACCOUNTS_DIR"):
        return Path(os.environ["CLAUDE_ACCOUNTS_DIR"])
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state) / "claude-accounts"


def slot_file(slot: int) -> Path:
    return accounts_dir() / f"{slot}.json"


def config_dir() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")


def parse_slot(text: str) -> int:
    if not text.isascii() or not text.isdigit():
        fail(f"invalid slot {safe(text)!r}", 2)
    # Keep stored slot IDs stable for token files, running sessions, and usage caches.
    return int(text) + 1


def slot_selector(slot: int) -> str:
    return "login" if slot == 0 else str(slot - 1)


def account_name(slot: int) -> str:
    return "ai-login" if slot == 0 else f"ai{slot_selector(slot)}"


def safe(value: str) -> str:
    return ''.join(c if c.isprintable() else f'\\u{ord(c):04x}' for c in value)


def read_json(path: Path):
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        return None, "missing"
    except (OSError, ValueError, UnicodeError):
        return None, "unreadable or invalid file"
    if not isinstance(data, dict):
        return None, "invalid file"
    return data, None


def valid_token(token) -> bool:
    return isinstance(token, str) and bool(token) and all(c.isprintable() and not c.isspace() for c in token)


def clean_env() -> dict:
    env = dict(os.environ)
    for name in (TOKEN_VAR, FINGERPRINT_VAR, *OVERRIDING_VARS):
        env.pop(name, None)
    if env.get("CLAUDE_CONFIG_DIR") == "":
        env.pop("CLAUDE_CONFIG_DIR")
    return env


def slot_env(slot: int) -> dict:
    env = clean_env()
    env[SLOT_VAR] = str(slot)
    if slot == 0:
        return env
    account, problem = read_json(slot_file(slot))
    if problem == "missing":
        fail(f"{account_name(slot)} has no token. Run: claude-account add {slot_selector(slot)}")
    if problem or not valid_token(account.get("token")):
        fail(f"{account_name(slot)} has an unreadable or invalid token file")
    env[TOKEN_VAR] = account["token"]
    env[FINGERPRINT_VAR] = fingerprint(account["token"])
    return env


def run(args: list[str]) -> None:
    slot = 0
    if args and (args[0] == "login" or args[0].isdigit()):
        selector = args.pop(0)
        if selector != "login":
            slot = parse_slot(selector)
    command = ["claude", "--settings", str(config_dir() / "local-settings.json"),
               "--dangerously-skip-permissions", *args]
    try:
        os.execvpe(command[0], command, slot_env(slot))
    except FileNotFoundError:
        fail("claude not found on PATH", 127)


def read_token() -> str:
    token = getpass.getpass("Paste the token (input hidden): ") if sys.stdin.isatty() else sys.stdin.readline()
    token = token.strip()
    if not valid_token(token):
        fail("expected one token without spaces")
    if not token.startswith("sk-ant-oat"):
        print("claude-account: warning: token does not start with sk-ant-oat", file=sys.stderr)
    return token


def write_private_json(path: Path, data: dict) -> None:
    for directory in dict.fromkeys((accounts_dir(), path.parent)):
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        directory.chmod(0o700)
    name = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, prefix=f".{path.stem}.", delete=False) as handle:
            name = handle.name
            json.dump(data, handle)
        os.replace(name, path)
    finally:
        if name is not None and os.path.exists(name):
            os.unlink(name)


def write_slot(slot: int, account: dict) -> None:
    write_private_json(slot_file(slot), account)


def metadata_options(args: list[str], *, allow_paste: bool = False) -> tuple[dict, bool]:
    values = {}
    paste = False
    while args:
        flag = args.pop(0)
        if flag == "--paste" and allow_paste and not paste:
            paste = True
        elif flag in ("--label", "--username") and args and flag[2:] not in values:
            value = args.pop(0)
            if not value.strip():
                fail(f"{flag} requires nonempty text", 2)
            values[flag[2:]] = value
        else:
            fail(USAGE, 2)
    return values, paste


def add(args: list[str]) -> None:
    if not args:
        fail(USAGE, 2)
    slot = parse_slot(args.pop(0))
    metadata, paste = metadata_options(args, allow_paste=True)
    if not paste:
        print(f"Sign in as the {account_name(slot)} account in the browser (a private window helps).",
              file=sys.stderr)
        env = clean_env()
        env["BROWSER"] = "true"
        if subprocess.run(["claude", "setup-token"], env=env).returncode:
            fail("claude setup-token failed")
    account = {"token": read_token(), "label": metadata.pop("label", ""),
               "added": datetime.date.today().isoformat(), **metadata}
    write_slot(slot, account)
    name = account_name(slot)
    launch = name if name in SHORTCUTS else f"claude-account run {slot_selector(slot)}"
    print(f"Saved {name}. Launch it with: {launch}")


def label_metadata(args: list[str]) -> None:
    if not args:
        fail(USAGE, 2)
    slot = parse_slot(args.pop(0))
    metadata, _ = metadata_options(args)
    if not metadata:
        fail(USAGE, 2)
    account, problem = read_json(slot_file(slot))
    if problem or not valid_token(account.get("token")):
        fail(f"{account_name(slot)} has no usable token file")
    account.update(metadata)
    write_slot(slot, account)
    print(f"Updated {account_name(slot)} metadata.")


def account_slots() -> list[int]:
    slots = {0, 1, 2, 3}
    try:
        for path in accounts_dir().iterdir():
            stem = path.stem
            if path.suffix == ".json" and stem.isascii() and stem.isdigit() and stem == str(int(stem)) and int(stem) > 0:
                slots.add(int(stem))
    except FileNotFoundError:
        pass
    return sorted(slots)


def load_account(slot: int) -> dict:
    account = {"slot": slot, "label": "/login" if slot == 0 else f"slot {slot_selector(slot)}",
               "username": None, "identity_source": "unknown", "token": None,
               "state": "missing", "scopes": None, "added": None}
    if slot == 0:
        data, problem = read_json(config_dir() / ".credentials.json")
        metadata_dir = config_dir() if os.environ.get("CLAUDE_CONFIG_DIR") else Path.home()
        identity, _ = read_json(metadata_dir / ".claude.json")
        identity = identity.get("oauthAccount") if identity else None
        email = identity.get("emailAddress") if isinstance(identity, dict) else None
        if isinstance(email, str) and email:
            account.update(username=email, identity_source="login cache")
        oauth = data.get("claudeAiOauth") if data else None
        if not problem and isinstance(oauth, dict):
            account["token"] = oauth.get("accessToken")
            scopes = oauth.get("scopes")
            if isinstance(scopes, list) and all(isinstance(item, str) for item in scopes):
                account["scopes"] = scopes
        elif not problem:
            problem = "invalid file"
    else:
        data, problem = read_json(slot_file(slot))
        if data is not None:
            for key in ("label", "username", "added"):
                if isinstance(data.get(key), str) and data[key]:
                    account[key] = data[key]
            if account["username"]:
                account["identity_source"] = "declared, unverified"
            account["token"] = data.get("token")
    if problem:
        account["state"] = problem
    elif valid_token(account["token"]):
        account["state"] = "configured"
    else:
        account["state"] = "invalid credential"
    return account


def list_slots() -> None:
    today = datetime.date.today()
    for slot in account_slots():
        account = load_account(slot)
        name = account_name(slot)
        if slot == 0:
            print(f"{name}  /login")
        elif account["state"] == "missing":
            print(f"{name}  not configured")
        elif account["state"] != "configured":
            print(f"{name}  {account['state']}")
        else:
            try:
                expires = datetime.date.fromisoformat(account["added"]) + datetime.timedelta(days=TOKEN_DAYS)
                left = (expires - today).days
                estimate = f"added {safe(account['added'])}, ~{left} days left" + ("  RENEW SOON" if left < 30 else "")
            except (TypeError, ValueError, OverflowError):
                estimate = "renewal estimate unavailable"
            print(f"{name}  token, {estimate}  {safe(account['label'])}")


def utc_now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def timestamp(value):
    if not isinstance(value, str):
        return None
    try:
        parsed = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
        if parsed.tzinfo is None or parsed.utcoffset() is None:
            return None
        return parsed.astimezone(datetime.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
    except (ValueError, OverflowError):
        return None


def window(value):
    if not isinstance(value, dict):
        return None
    used = value.get("utilization")
    if isinstance(used, bool) or not isinstance(used, (int, float)) or not 0 <= used <= 100:
        return None
    return {"remaining": 100 - used, "reset": timestamp(value.get("resets_at"))}


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def fetch_usage(token: str) -> dict:
    result = {"five_hour": None, "seven_day": None, "reason": None,
              "attempted_at": utc_now(), "fetched_at": None, "accepted": False, "rejected": False}
    request = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
        "Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"})
    try:
        with urllib.request.build_opener(NoRedirect()).open(request, timeout=5) as response:
            body = response.read(1024 * 1024)
        result["accepted"] = True
        payload = json.loads(body)
        if not isinstance(payload, dict):
            raise ValueError("invalid response")
        result.update(accepted=True, fetched_at=utc_now(), five_hour=window(payload.get("five_hour")),
                      seven_day=window(payload.get("seven_day")))
        if not result["five_hour"] and not result["seven_day"]:
            result["reason"] = "usage windows unavailable"
    except urllib.error.HTTPError as error:
        if error.code == 401:
            result.update(rejected=True, reason="credential rejected by usage endpoint")
        elif error.code == 403:
            result["reason"] = "usage permission unavailable"
        elif error.code == 429:
            result["reason"] = "usage endpoint rate limited"
        elif 300 <= error.code < 400:
            result["reason"] = "usage redirect refused"
        else:
            result["reason"] = "usage endpoint unavailable"
        error.close()
    except (OSError, http.client.HTTPException, ValueError, UnicodeError, OverflowError):
        result["reason"] = "usage request or response unavailable"
    return result


def account_report(slot: int) -> dict:
    account = load_account(slot)
    usage = {"five_hour": None, "seven_day": None, "reason": None,
             "attempted_at": None, "fetched_at": None, "accepted": False, "rejected": False}
    auth = account["state"]
    if auth == "configured":
        auth = "configured; unverified"
        if slot != 0:
            observations = cached_usage(slot, fingerprint(account["token"]), time.time())
            for name, observation in observations.items():
                usage[name] = {"remaining": observation.remaining, "reset": format_epoch(observation.reset),
                               "source": "status line", "observed_at": format_epoch(observation.observed_at)}
            if not observations:
                usage["reason"] = "status line usage unavailable"
        elif account["scopes"] is not None and "user:profile" not in account["scopes"]:
            usage["reason"] = "profile permission unavailable"
        else:
            usage = fetch_usage(account["token"])
            if usage["accepted"]:
                auth = "configured; usage accepted"
            elif usage["rejected"]:
                auth = "rejected by usage endpoint"
    else:
        usage["reason"] = "credential unavailable"
    return {"slot": slot, "label": account["label"], "username": account["username"],
            "identity_source": account["identity_source"], "auth": auth, "usage": usage}


def render_reports(reports: list[dict]) -> str:
    rows = []
    details = []
    for report in reports:
        name = account_name(report["slot"])
        username = safe(report["username"]) if report["username"] else "unknown"
        usage = report["usage"]
        windows = [usage["five_hour"], usage["seven_day"]]
        rows.append([name, safe(report["label"]), f"{username} [{report['identity_source']}]",
                     report["auth"], *(f"{item['remaining']:g}%" if item else "unavailable" for item in windows)])
        resets = []
        for title, item in zip(("5h", "week"), windows):
            if item:
                detail = f"{title} reset {item['reset'] or 'unknown'}"
                if "source" in item:
                    detail += f" ({item['source']}, observed {item['observed_at'] or 'unknown'})"
                resets.append(detail)
        fields = [*resets, usage["reason"],
                  f"attempted {usage['attempted_at']}" if usage["attempted_at"] else None,
                  f"fetched {usage['fetched_at']}" if usage["fetched_at"] else None]
        details.append(f"{name}: " + "; ".join(field for field in fields if field))
    header = ["ACCOUNT", "NICKNAME", "USERNAME [SOURCE]", "AUTH", "5H LEFT", "WEEK LEFT"]
    widths = [max(len(row[i]) for row in [header, *rows]) for i in range(len(header))]
    lines = ["  ".join(value.ljust(widths[i]) for i, value in enumerate(row)).rstrip()
             for row in [header, *rows]]
    return "\n".join([*lines, *details])


def status(args: list[str]) -> None:
    if not args or args == ["login"]:
        slots = [0]
    elif args == ["--all"]:
        slots = account_slots()
    elif len(args) == 1:
        slots = [parse_slot(args[0])]
    else:
        fail(USAGE, 2)
    print(render_reports([account_report(slot) for slot in slots]))


def fingerprint(token: str) -> str:
    return hashlib.sha256(token.encode()).hexdigest()


def observation_file(slot: int, credential: str, window: str) -> Path:
    return accounts_dir() / "usage" / f"{slot}-{credential}-{window}.json"


def percentage(value) -> bool:
    return type(value) in (int, float) and 0 <= value <= 100


def epoch(value) -> bool:
    return type(value) in (int, float) and 0 <= value <= 253402300800


def report_epoch(value):
    return datetime.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp() if value else None


def format_epoch(value: float | None) -> str | None:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(value)) if value is not None else None


def statusline_window(value):
    if not isinstance(value, dict) or not percentage(value.get("used_percentage")):
        return None
    reset = value.get("resets_at")
    return {"remaining": 100 - value["used_percentage"], "reset": reset if epoch(reset) else None}


@dataclass(frozen=True)
class UsageObservation:
    remaining: float
    reset: float
    observed_at: float | None


def cached_usage(slot: int, credential: str, now: float) -> dict[str, UsageObservation]:
    observations = {}
    for name in WINDOWS:
        data, _ = read_json(observation_file(slot, credential, name))
        if data is None:
            continue
        remaining = data.get("remaining")
        reset = data.get("reset")
        if not percentage(remaining) or not epoch(reset) or reset <= now:
            continue
        observed_at = data.get("observed_at")
        observations[name] = UsageObservation(remaining, reset, observed_at if epoch(observed_at) else None)
    return observations


@dataclass(frozen=True)
class Identity:
    username: str | None
    credential: str | None

    @classmethod
    def from_account(cls, account: dict):
        username = (account["username"] or "").strip().casefold() or None
        credential = fingerprint(account["token"]) if account["state"] == "configured" else None
        return cls(username, credential)

    def matches(self, other) -> bool:
        return ((self.username is not None and self.username == other.username)
                or (self.credential is not None and self.credential == other.credential))


@dataclass(frozen=True)
class AccountUsage:
    slot: int
    identity: Identity
    remaining: tuple
    source: str
    observed_at: float | None
    unavailable: str | None = None


def numbered_usage_candidates(now: float) -> list[AccountUsage]:
    candidates = []
    for slot in account_slots():
        if slot == 0:
            continue
        identity = Identity.from_account(load_account(slot))
        if identity.credential is None:
            continue
        observations = cached_usage(slot, identity.credential, now)
        allowance = tuple(observations[name].remaining if name in observations else None for name in WINDOWS)
        timestamps = (item.observed_at for item in observations.values() if item.observed_at is not None)
        candidates.append(AccountUsage(slot, identity, allowance, "statusline", min(timestamps, default=None)))
    return candidates


def usage_candidates() -> list[AccountUsage]:
    login_usage = account_report(0)["usage"]
    now = time.time()
    live = []
    for name in WINDOWS:
        item = login_usage[name]
        reset = report_epoch(item["reset"]) if item else None
        live.append(item["remaining"] if item and (reset is None or (epoch(reset) and reset > now)) else None)
    live_at = report_epoch(login_usage["fetched_at"])
    account = load_account(0)
    unavailable = None
    if account["state"] != "configured" or login_usage["rejected"]:
        unavailable = login_usage["reason"] or account["state"]
    login_candidate = AccountUsage(0, Identity.from_account(account), tuple(live), "live ai-login", live_at, unavailable)
    candidates = [login_candidate, *numbered_usage_candidates(now)]
    if login_candidate.unavailable:
        return candidates
    aliases = sorted((candidate for candidate in candidates[1:]
                      if candidate.identity.matches(login_candidate.identity)),
                     key=lambda candidate: candidate.observed_at or 0, reverse=True)
    for alias in aliases:
        combined = tuple(primary if primary is not None else cached
                         for primary, cached in zip(login_candidate.remaining, alias.remaining))
        if combined != login_candidate.remaining:
            dates = (date for date in (login_candidate.observed_at, alias.observed_at) if date is not None)
            source = "live ai-login + statusline" if live_at is not None else "statusline"
            login_candidate = replace(login_candidate, remaining=combined, source=source,
                                      observed_at=min(dates, default=None))
    candidates[0] = login_candidate
    for alias in aliases:
        candidates[candidates.index(alias)] = replace(alias, remaining=login_candidate.remaining,
                                                      source=login_candidate.source,
                                                      observed_at=login_candidate.observed_at)
    return candidates


def usage_snapshot(args: list[str]) -> None:
    if args:
        fail(USAGE, 2)
    print(json.dumps([
        {"name": account_name(item.slot), "selector": slot_selector(item.slot),
         "remaining": item.remaining, "source": item.source,
         "observed_at": item.observed_at, "unavailable": item.unavailable}
        for item in usage_candidates()
    ]))


def reserve_round_slot(slots: list[int]) -> int:
    directory = accounts_dir()
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    cursor = directory / "round-robin.json"
    # Keep the lock on a separate file because write_private_json replaces the cursor.
    descriptor = os.open(directory / ".round-robin.lock", os.O_CREAT | os.O_RDWR, 0o600)
    with os.fdopen(descriptor, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        saved, _ = read_json(cursor)
        previous = (saved or {}).get("slot")
        if type(previous) is not int:
            previous = -1
        slot = next((slot for slot in slots if slot > previous), slots[0])
        write_private_json(cursor, {"slot": slot})
    return slot


def run_round(args: list[str]) -> None:
    if args[:1] in (["-h"], ["--help"]):
        print(f"""usage: ai-round [CLAUDE_ARGS...]

Start Claude in the current terminal. Rotate through configured slots ai0 and up.
Skip a slot if a current status line reading shows less than {ROUND_MIN_REMAINING}% remaining
in either the 5-hour or 7-day window. Slots with unknown allowance get a turn.

Run ai-round --resume to resume a session.
Use ai-round -- --help to get help from Claude.""")
        return
    if args[:1] == ["--"]:
        args = args[1:]

    eligible: dict[int, AccountUsage] = {}
    for item in numbered_usage_candidates(time.time()):
        if any(value is not None and value < ROUND_MIN_REMAINING for value in item.remaining):
            continue
        if not any(item.identity.matches(account.identity) for account in eligible.values()):
            eligible[item.slot] = item
    if not eligible:
        raise SystemExit("ai-round: no eligible numbered slot. Configure a slot with claude-account add N "
                         f"or wait for usage windows below {ROUND_MIN_REMAINING}% to reset.")
    try:
        slot = reserve_round_slot(list(eligible))
    except OSError as error:
        raise SystemExit(f"ai-round: could not save rotation: {error}") from None
    note = " with unknown allowance" if None in eligible[slot].remaining else ""
    print(f"Starting {account_name(slot)}{note}", file=sys.stderr, flush=True)
    run([slot_selector(slot), *args])


def observed_account() -> tuple[int, str] | None:
    if any(os.environ.get(name) for name in OVERRIDING_VARS):
        return None
    token = os.environ.get(TOKEN_VAR)
    stamped = os.environ.get(SLOT_VAR)
    if token is None:
        credential = os.environ.get(FINGERPRINT_VAR)
        if not credential:
            return None
        try:
            slot = int(stamped or "")
        except ValueError:
            return None
        if slot <= 0 or str(slot) != stamped:
            return None
        account = load_account(slot)
        if account["state"] == "configured" and fingerprint(account["token"]) == credential:
            return slot, credential
        return None
    if not valid_token(token):
        return None
    slots = [slot for slot in account_slots() if slot > 0]
    slots.sort(key=lambda slot: str(slot) != stamped)
    for slot in slots:
        account = load_account(slot)
        if account["token"] == token:
            return slot, fingerprint(token)
    return None


def observe(args: list[str]) -> None:
    if args:
        fail("usage: claude-account observe < statusline.json", 2)
    try:
        payload = json.load(sys.stdin)
    except (ValueError, UnicodeError):
        return
    limits = payload.get("rate_limits") if isinstance(payload, dict) else None
    if not isinstance(limits, dict):
        return
    windows = {name: statusline_window(limits.get(name)) for name in WINDOWS}
    if not any(windows.values()):
        return
    observed = observed_account()
    if observed is None:
        return
    slot, credential = observed
    now = time.time()
    for name, window in windows.items():
        if window is not None:
            write_private_json(observation_file(slot, credential, name), {"observed_at": now, **window})


def remove(args: list[str]) -> None:
    if len(args) != 1:
        fail(USAGE, 2)
    slot = parse_slot(args[0])
    try:
        slot_file(slot).unlink()
    except FileNotFoundError:
        fail(f"{account_name(slot)} has no token")
    print(f"Removed the local token for {account_name(slot)}. To revoke it, use "
          "claude.ai Settings > Claude Code.")


def main() -> None:
    shortcut = SHORTCUTS.get(Path(sys.argv[0]).name, ())
    args = [*shortcut, *sys.argv[1:]]
    commands = {"run": run, "round": run_round, "add": add, "label": label_metadata, "status": status,
                "remove": remove, "observe": observe, "usage-snapshot": usage_snapshot}
    if args == ["list"]:
        list_slots()
    elif not args or args[0] not in commands:
        fail(USAGE, 2)
    else:
        commands[args[0]](args[1:])


if __name__ == "__main__":
    try:
        main()
    except OSError:
        fail("could not access account data or write output")
