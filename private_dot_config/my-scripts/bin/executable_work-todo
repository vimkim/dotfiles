#!/usr/bin/env python3
"""Show all scheduled work, dispatching todo shortcuts by invocation name."""
import os
from pathlib import Path
import sys

PRESETS = {
    "todo-today": ["today"],
    "todo-3days": ["--days", "3"],
    "todo-5days": ["--days", "5"],
}


def main():
    name = Path(sys.argv[0]).name
    args = sys.argv[1:]
    if name == "work-todo":
        forwarded = args
    elif name in PRESETS:
        # Only non-horizon options are valid for a fixed-horizon shortcut.
        # Treat a database argument as opaque even when it resembles an option.
        index = 0
        while index < len(args):
            arg = args[index]
            if arg in ("--database", "--color"):
                if index + 1 == len(args):
                    print(f"{name}: {arg} requires a value", file=sys.stderr)
                    return 2
                index += 2
                continue
            if arg in ("--all", "--json", "--help", "-h", "--version", "-V") or arg.startswith(("--database=", "--color=")):
                index += 1
                continue
            print(f"{name}: fixed horizon; use work-todo for other options: {arg}", file=sys.stderr)
            return 2
        forwarded = PRESETS[name] + args
    else:
        print(f"{name}: unknown todo shortcut", file=sys.stderr)
        return 2
    try:
        os.execvp("work-tracker", ["work-tracker", "todo", "--all", *forwarded])
    except FileNotFoundError:
        print(f"{name}: work-tracker is not installed or is not on PATH", file=sys.stderr)
        return 127
    except OSError as error:
        print(f"{name}: {error}", file=sys.stderr)
        return 126


if __name__ == "__main__":
    sys.exit(main())
