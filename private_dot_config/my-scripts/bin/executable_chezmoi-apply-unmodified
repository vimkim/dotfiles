#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: chezmoi-apply-unmodified [--source DIR] [--config FILE] [-- ABSOLUTE_FILE...]

Apply managed files and symlinks whose destinations have no local changes.
Without targets, consider all managed files and symlinks. Explicit targets
are not traversed recursively. Locally changed targets are reported as skipped;
existing targets without last-write history are also skipped. Skips succeed,
while chezmoi errors fail. Run scripts are not executed.

Options:
  -S, --source DIR   Use this chezmoi source checkout
  -c, --config FILE  Use this chezmoi configuration
  -h, --help         Show this help
EOF
}

usage_error() {
    printf 'chezmoi-apply-unmodified: %s\n' "$1" >&2
    usage >&2
    exit 2
}

chezmoi_options=()
targets=()
while (($#)); do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -S|--source|-c|--config)
            (($# >= 2)) && [[ -n $2 ]] || usage_error "$1 requires a value"
            chezmoi_options+=("$1" "$2")
            shift 2
            ;;
        --source=*|--config=*)
            [[ -n ${1#*=} ]] || usage_error "$1 requires a value"
            chezmoi_options+=("$1")
            shift
            ;;
        --)
            shift
            targets+=("$@")
            break
            ;;
        -*)
            usage_error "unknown option: $1"
            ;;
        *)
            targets+=("$1")
            shift
            ;;
    esac
done

for target in "${targets[@]}"; do
    [[ $target == /* ]] || usage_error "target must be absolute: $target"
done

status_options=('--include=files,symlinks' --path-style=absolute --color=false)
if ((${#targets[@]})); then
    status_options+=(--recursive=false)
fi

# Finish the scan before applying anything, so a failed scan cannot produce a
# partial deployment. The first status column compares disk to the last write.
status_file=$(mktemp "${TMPDIR:-/tmp}/chezmoi-apply-unmodified.XXXXXX")
trap 'rm -f -- "$status_file"' EXIT
chezmoi "${chezmoi_options[@]}" status "${status_options[@]}" -- "${targets[@]}" > "$status_file"

apply_targets=()
skip_messages=()
while IFS= read -r status_line || [[ -n $status_line ]]; do
    if [[ ${#status_line} -lt 4 || ${status_line:2:2} != ' /' ]]; then
        printf '%s\n' 'chezmoi-apply-unmodified: unexpected status output; no targets applied' >&2
        exit 1
    fi
    target=${status_line:3}
    if [[ ${status_line:0:1} != ' ' ]]; then
        skip_messages+=("Skipped locally changed target: $target")
        continue
    fi
    # Without a last-write record, status cannot distinguish an existing local
    # file from an unchanged destination. Preserve it until reviewed separately.
    if [[ -e $target || -L $target ]]; then
        last_write=$(chezmoi "${chezmoi_options[@]}" state get --bucket=entryState --key="$target")
        if [[ -z $last_write ]]; then
            skip_messages+=("Skipped pre-existing target without last-write state: $target")
            continue
        fi
    fi
    apply_targets+=("$target")
done < "$status_file"

for message in "${skip_messages[@]}"; do
    printf '%s\n' "$message"
done

for target in "${apply_targets[@]}"; do
    # Each call names one file. Check again for edits made after the scan.
    chezmoi "${chezmoi_options[@]}" apply --parent-dirs --recursive=false --error-on-conflict -- "$target"
done
