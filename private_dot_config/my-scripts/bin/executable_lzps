#!/bin/sh

# Resolve lazydocker before sudo replaces the user's PATH.
if ! lazydocker_path=$(command -v lazydocker); then
    printf '%s\n' 'lzps: lazydocker was not found in PATH.' >&2
    exit 127
fi

case "$lazydocker_path" in
    /*) ;;
    *) lazydocker_path="$PWD/$lazydocker_path" ;;
esac

exec sudo -- DOCKER_HOST=unix:///run/podman/podman.sock "$lazydocker_path" "$@"
