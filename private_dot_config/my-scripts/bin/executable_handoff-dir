#!/usr/bin/env python3
"""Create .handoff/.gitignore in the current directory."""

from pathlib import Path

handoff_dir = Path(".handoff")
try:
    handoff_dir.mkdir()
except FileExistsError:
    if not handoff_dir.is_dir():
        raise
    status = f"Already exists: {handoff_dir}/"
else:
    status = f"Created: {handoff_dir}/"

(handoff_dir / ".gitignore").write_text("*\n", encoding="utf-8")
print(status)
