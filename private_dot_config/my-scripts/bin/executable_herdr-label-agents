#!/usr/bin/env python3
"""Label unnamed Herdr panes with their agent names; preserve existing labels."""

import json
import os
import subprocess
import sys


def read(*args):
    return json.loads(subprocess.check_output(["herdr", *args], text=True))["result"]


if os.environ.get("HERDR_ENV") != "1":
    sys.exit("herdr-label-agents: run this command inside Herdr")

for agent in read("agent", "list")["agents"]:
    name = agent.get("name")
    if not name:
        continue
    pane_id = agent["pane_id"]
    label = read("pane", "get", pane_id)["pane"].get("label")
    if label == name:
        print(f"unchanged {pane_id} -> {name}")
    elif label:
        print(f"skipped {pane_id}: keeping {label!r} (agent {name})")
    else:
        subprocess.run(
            ["herdr", "pane", "rename", pane_id, name],
            check=True,
            stdout=subprocess.DEVNULL,
        )
        print(f"labeled {pane_id} -> {name}")
