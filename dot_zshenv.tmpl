if [ -r "$HOME/.cargo/env" ]; then
    . "$HOME/.cargo/env"
fi

{{ template "deeptutor-env.sh" . }}

# Claude Code picks zsh before bash when SHELL is not bash or zsh. Pin bash
# for Claude Code only; nu's env.nu does the same for nu-launched sessions.
for claude_code_bash in /home/linuxbrew/.linuxbrew/bin/bash /bin/bash; do
    if [ -x "$claude_code_bash" ]; then
        export CLAUDE_CODE_SHELL="$claude_code_bash"
        break
    fi
done
unset claude_code_bash
