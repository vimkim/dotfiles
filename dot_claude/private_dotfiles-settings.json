{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SHELL": "/home/linuxbrew/.linuxbrew/bin/bash",
    "FORCE_HYPERLINK": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "WebSearch",
      "WebFetch",
      "Bash(grep:*)",
      "Bash(just build:*)",
      "Bash(just test:*)",
      "Bash(just build-test:*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git blame*)",
      "Bash(find:*)",
      "Bash(file *)",
      "Bash(printenv*)",
      "Bash(tree *)",
      "Bash(whoami*)",
      "Bash(hostname*)",
      "Bash(pwd*)",
      "Bash(date*)",
      "Bash(ps *)",
      "Bash(top -bn1*)",
      "Bash(lsof *)",
      "Bash(ss *)",
      "Bash(netstat *)",
      "Bash(nm *)",
      "Bash(objdump *)",
      "Bash(readelf *)",
      "Bash(git stash list*)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(jq *)",
      "Bash(man *)",
      "Bash(md5sum *)",
      "Bash(sha256sum *)",
      "Bash(pkg-config *)",
      "Bash(cubrid-jira-search *)",
      "Bash(/home/vimkim/.claude/skills/cubrid-oos-context/scripts/validate-env.sh*)",
      "Bash(cubrid-jira *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "/home/vimkim/gh"
    ]
  },
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline.sh"
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Running the cubrid-jira CLI to comment on, create, or update jira.cubrid.org issues when the user approved the content in the conversation."
    ]
  }
}
